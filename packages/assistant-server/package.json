{
  "name": "@turnturn/assistant-server",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "turnturn-assistant-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.type-tests.json --noEmit"
  },
  "dependencies": {
    "@turnturn/assistant-core": "workspace:*",
    "@turnturn/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.2"
  }
}
