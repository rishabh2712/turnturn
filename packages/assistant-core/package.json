{
  "name": "@turnturn/assistant-core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./approval-registry": {
      "types": "./dist/approval-registry.d.ts",
      "import": "./dist/approval-registry.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js"
    },
    "./provider-step-runner": {
      "types": "./dist/provider-step-runner.d.ts",
      "import": "./dist/provider-step-runner.js"
    },
    "./providers/sse": {
      "types": "./dist/providers/sse.d.ts",
      "import": "./dist/providers/sse.js"
    },
    "./providers/openai-chat-completions": {
      "types": "./dist/providers/openai-chat-completions/index.d.ts",
      "import": "./dist/providers/openai-chat-completions/index.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js"
    },
    "./rejections": {
      "types": "./dist/rejections.d.ts",
      "import": "./dist/rejections.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./tool-wave-runner": {
      "types": "./dist/tool-wave-runner.d.ts",
      "import": "./dist/tool-wave-runner.js"
    },
    "./turn-runtime": {
      "types": "./dist/turn-runtime.d.ts",
      "import": "./dist/turn-runtime.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./workspace-tools": {
      "types": "./dist/workspace-tools.d.ts",
      "import": "./dist/workspace-tools.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "pnpm build && node --test test/*.test.mjs test/providers/*.test.mjs test/providers/openai-chat-completions/*.test.mjs",
    "typecheck": "tsc -p tsconfig.type-tests.json --noEmit"
  },
  "dependencies": {
    "@turnturn/protocol": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "typescript": "5.9.2"
  }
}
